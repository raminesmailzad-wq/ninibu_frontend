# Backend عمومی نینیبو؛ برای تست Expo Go همین مقدار پیشنهاد می‌شود.
EXPO_PUBLIC_NINIBU_BACKEND_URL=https://ninibu.com

# Metro در این پروژه روی 8082 اجرا می‌شود تا با Backend :8081 تداخل نداشته باشد.
# برای Backend لوکال فقط IP قابل دسترس از خود گوشی را استفاده کنید، مثال:
# EXPO_PUBLIC_NINIBU_BACKEND_URL=http://192.168.1.20:8081
