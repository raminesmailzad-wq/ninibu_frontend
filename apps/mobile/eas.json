{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_NINIBU_BACKEND_URL": "https://ninibu.com",
        "EXPO_PUBLIC_NINIBU_MAP_TILE_URL": "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
        "EXPO_PUBLIC_NINIBU_PAYMENT_PROVIDER": "sandbox"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_NINIBU_BACKEND_URL": "https://ninibu.com",
        "EXPO_PUBLIC_NINIBU_MAP_TILE_URL": "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
        "EXPO_PUBLIC_NINIBU_PAYMENT_PROVIDER": "disabled"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_NINIBU_BACKEND_URL": "https://ninibu.com",
        "EXPO_PUBLIC_NINIBU_PAYMENT_PROVIDER": "disabled",
        "NODE_ENV": "production",
        "EXPO_PUBLIC_NINIBU_MAP_TILE_URL": "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
      }
    }
  }
}
