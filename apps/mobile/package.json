{
  "name": "@ninibu/mobile",
  "version": "0.24.2",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --port 8082",
    "start:clear": "expo start -c --port 8082",
    "start:tunnel": "expo start -c --tunnel --port 8082",
    "android": "expo start --android --port 8082",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "expo lint",
    "start:lan": "expo start -c --lan --port 8082",
    "pretypecheck": "node ../../scripts/mobile-font-prepare.mjs && node ../../scripts/mobile-preflight.mjs && node ../../scripts/mobile-hooks-audit.mjs && node ../../scripts/mobile-parity-audit.mjs && node ../../scripts/mobile-font-audit.mjs",
    "prestart": "node ../../scripts/mobile-font-prepare.mjs && node ../../scripts/mobile-preflight.mjs && node ../../scripts/mobile-hooks-audit.mjs && node ../../scripts/mobile-parity-audit.mjs && node ../../scripts/mobile-font-audit.mjs",
    "prestart:clear": "node ../../scripts/mobile-font-prepare.mjs && node ../../scripts/mobile-preflight.mjs && node ../../scripts/mobile-hooks-audit.mjs && node ../../scripts/mobile-parity-audit.mjs && node ../../scripts/mobile-font-audit.mjs",
    "prestart:tunnel": "node ../../scripts/mobile-font-prepare.mjs && node ../../scripts/mobile-preflight.mjs && node ../../scripts/mobile-hooks-audit.mjs && node ../../scripts/mobile-parity-audit.mjs && node ../../scripts/mobile-font-audit.mjs",
    "prestart:lan": "node ../../scripts/mobile-font-prepare.mjs && node ../../scripts/mobile-preflight.mjs && node ../../scripts/mobile-hooks-audit.mjs && node ../../scripts/mobile-parity-audit.mjs && node ../../scripts/mobile-font-audit.mjs",
    "eas-build-pre-install": "node ../../scripts/mobile-font-prepare.mjs && node ../../scripts/mobile-preflight.mjs",
    "eas-build-post-install": "cd ../.. && pnpm --filter @ninibu/mobile typecheck"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@ninibu/api": "workspace:*",
    "@ninibu/datetime": "workspace:*",
    "@ninibu/design": "workspace:*",
    "@ninibu/types": "workspace:*",
    "@ninibu/validation": "workspace:*",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.14",
    "expo-linear-gradient": "~15.0.8",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "expo-font": "~14.0.12",
    "expo-location": "~19.0.8",
    "react-native-webview": "13.15.0",
    "expo-linking": "~8.0.12",
    "expo-system-ui": "~6.0.9",
    "expo-image-picker": "~17.0.11",
    "expo-camera": "~17.0.10"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.0",
    "typescript": "~5.9.2"
  }
}
