NINIBU_BACKEND_URL=http://localhost:8081
NEXT_PUBLIC_NINIBU_DEV_OTP=

# Optional: provider/collector endpoint for privacy-safe frontend analytics events.
NEXT_PUBLIC_NINIBU_ANALYTICS_ENDPOINT=

# Payment gateway selected by the deployment. Local development uses sandbox.
NEXT_PUBLIC_NINIBU_PAYMENT_PROVIDER=sandbox

# Raster tile URL used by the web care map. Configure a production provider with an SLA.
NEXT_PUBLIC_NINIBU_MAP_TILE_URL=
